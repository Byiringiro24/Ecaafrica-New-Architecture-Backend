generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model subscription_plans {
  id                   BigInt                 @id @default(autoincrement())
  name                 String                 @db.VarChar(100)
  price_monthly        Decimal                @default(0) @db.Decimal(12, 2)
  price_annual         Decimal                @default(0) @db.Decimal(12, 2)
  student_limit        Int                    @default(0)
  staff_limit          Int                    @default(0)
  sms_bundle           Int                    @default(0)
  features             Json?
  is_active            Boolean                @default(true)
  sort_order           Int                    @default(0) @db.SmallInt
  created_at           DateTime               @default(now()) @db.Timestamptz(3)
  updated_at           DateTime               @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at           DateTime?              @db.Timestamptz(3)
  school_subscriptions school_subscriptions[]
  schools              schools[]

  @@index([created_at])
  @@index([updated_at])
  @@index([deleted_at])
}

model schools {
  id                               BigInt                             @id @default(autoincrement())
  uuid                             String                             @unique @db.Char(36)
  name                             String                             @db.VarChar(255)
  school_type                      SchoolType                         @default(government)
  province                         String                             @db.VarChar(100)
  district                         String                             @db.VarChar(100)
  sector                           String?                            @db.VarChar(100)
  logo_url                         String?                            @db.VarChar(500)
  website                          String?                            @db.VarChar(255)
  principal_name                   String?                            @db.VarChar(255)
  principal_phone                  String?                            @db.VarChar(20)
  principal_email                  String?                            @db.VarChar(255)
  school_phone                     String?                            @db.VarChar(20)
  school_email                     String?                            @db.VarChar(255)
  subscription_plan_id             BigInt?
  status                           SchoolStatus                       @default(trial)
  trial_ends_at                    DateTime?                          @db.Timestamptz(3)
  grace_ends_at                    DateTime?                          @db.Timestamptz(3)
  timezone                         String                             @default("Africa/Kampala") @db.VarChar(50)
  currency                         String                             @default("RWF") @db.Char(3)
  has_boarding                     Boolean                            @default(false)
  has_biometrics                   Boolean                            @default(false)
  has_gate                         Boolean                            @default(false)
  has_visitor_mgmt                 Boolean                            @default(false)
  has_exam_system                  Boolean                            @default(false)
  has_salary_mgmt                  Boolean                            @default(false)
  has_parent_app                   Boolean                            @default(false)
  has_bulk_sms                     Boolean                            @default(false)
  settings                         Json?
  created_at                       DateTime                           @default(now()) @db.Timestamptz(3)
  updated_at                       DateTime                           @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at                       DateTime?                          @db.Timestamptz(3)
  country                          String?                            @db.VarChar(100)
  absence_alerts                   absence_alerts[]
  academic_years                   academic_years[]
  announcement_reads               announcement_reads[]
  attendance_records               attendance_records[]
  attendance_logs                  attendance_logs[]
  attendance_sessions              attendance_sessions[]
  biometric_enrollments            biometric_enrollments[]
  boarding_roll_calls              boarding_roll_calls[]
  dormitory_supervisor_assignments dormitory_supervisor_assignments[]
  classes                          classes[]
  device_sessions                  device_sessions[]
  devices                          devices[]
  dorm_rooms                       dorm_rooms[]
  dormitories                      dormitories[]
  exam_results                     exam_results[]
  exams                            exams[]
  exam_types                       exam_types[]
  grading_roles                    grading_roles[]
  report_cards                     report_cards[]
  expenses                         expenses[]
  expense_categories               expense_categories[]
  inventory_categories             inventory_categories[]
  fee_structures                   fee_structures[]
  fee_transactions                 fee_transactions[]
  gate_logs                        gate_logs[]
  holidays                         holidays[]
  inventory_items                  inventory_items[]
  invoices                         invoices[]
  payroll_runs                     payroll_runs[]
  payslips                         payslips[]
  suppliers                        suppliers[]
  student_invoices                 student_invoices[]
  messages                         messages[]
  notification_logs                notification_logs[]
  notification_templates           notification_templates[]
  attendance_sms_mappings          attendance_sms_mappings[]
  offline_sync_queue               offline_sync_queue[]
  parents_guardians                parents_guardians[]
  platform_user_school_assignments platform_user_school_assignments[]
  roles                            roles[]
  salary_records                   salary_records[]
  school_levels                    school_levels[]
  school_subscriptions             school_subscriptions[]
  subscription_plan                subscription_plans?                @relation(fields: [subscription_plan_id], references: [id])
  sections                         sections[]
  staff_leave_balances             staff_leave_balances[]
  staff_profiles                   staff_profiles[]
  student_dorm_assignments         student_dorm_assignments[]
  student_fee_assignments          student_fee_assignments[]
  student_leave_requests           student_leave_requests[]
  student_section_enrollments      student_section_enrollments[]
  students                         students[]
  subjects                         subjects[]
  support_tickets                  support_tickets[]
  tablets                          tablets[]
  teacher_section_subjects         teacher_section_subjects[]
  terms                            terms[]
  timetable_periods                timetable_periods[]
  timetable_slots                  timetable_slots[]
  user_roles                       user_roles[]
  users                            users[]
  visitor_appointments             visitor_appointments[]
  visitor_visits                   visitor_visits[]
  visitors                         visitors[]
  boarding_attendance_windows      boarding_attendance_windows[]
  boarding_attendance_sessions     boarding_attendance_sessions[]
  boarding_attendance_records      boarding_attendance_records[]
  boarding_configurations          boarding_configurations?
  dos_work_items                   dos_work_items[]
  dining_menus                     dining_menus[]
  dining_menu_items                dining_menu_items[]
  dining_schedules                 dining_schedules[]
  dining_sessions                  dining_sessions[]
  dining_attendance                dining_attendance[]
  gate_exit_records                gate_exit_records[]
  patron_dormitory_assignments     patron_dormitory_assignments[]
  dining_teacher_assignments       dining_teacher_assignments[]
  subject_combinations              subject_combinations[]
  class_combinations                class_combinations[]
  combination_subjects              combination_subjects[]

  @@index([status])
  @@index([country])
  @@index([province])
  @@index([trial_ends_at])
  @@index([grace_ends_at])
  @@index([created_at])
  @@index([updated_at])
  @@index([deleted_at])
}

model school_subscriptions {
  id                  BigInt                   @id @default(autoincrement())
  school_id           BigInt
  plan_id             BigInt
  billing_cycle       BillingCycle             @default(monthly)
  amount              Decimal                  @db.Decimal(12, 2)
  currency            String                   @default("RWF") @db.Char(3)
  status              SchoolSubscriptionStatus @default(pending)
  starts_at           DateTime                 @db.Timestamptz(3)
  ends_at             DateTime?                @db.Timestamptz(3)
  trial_ends_at       DateTime?                @db.Timestamptz(3)
  grace_ends_at       DateTime?                @db.Timestamptz(3)
  auto_renew          Boolean                  @default(true)
  cancelled_at        DateTime?                @db.Timestamptz(3)
  cancellation_reason String?
  notes               String?
  created_by          BigInt?
  created_at          DateTime                 @default(now()) @db.Timestamptz(3)
  updated_at          DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  invoices            invoices[]
  plan                subscription_plans       @relation(fields: [plan_id], references: [id])
  school              schools                  @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@index([school_id])
  @@index([status])
  @@index([starts_at])
  @@index([ends_at])
  @@index([trial_ends_at])
  @@index([grace_ends_at])
  @@index([cancelled_at])
  @@index([created_at])
  @@index([updated_at])
}

model invoices {
  id              BigInt                @id @default(autoincrement())
  invoice_number  String                @unique @db.VarChar(30)
  school_id       BigInt
  subscription_id BigInt?
  period_start    DateTime              @db.Date
  period_end      DateTime              @db.Date
  issue_date      DateTime              @db.Date
  due_date        DateTime              @db.Date
  subtotal        Decimal               @default(0) @db.Decimal(12, 2)
  tax_rate        Decimal               @default(0) @db.Decimal(5, 2)
  tax_amount      Decimal               @default(0) @db.Decimal(12, 2)
  discount_amount Decimal               @default(0) @db.Decimal(12, 2)
  total           Decimal               @default(0) @db.Decimal(12, 2)
  currency        String                @default("RWF") @db.Char(3)
  status          InvoiceStatus         @default(draft)
  paid_at         DateTime?             @db.Timestamptz(3)
  payment_method  String?               @db.VarChar(50)
  payment_ref     String?               @db.VarChar(100)
  notes           String?
  pdf_url         String?               @db.VarChar(500)
  created_by      BigInt?
  created_at      DateTime              @default(now()) @db.Timestamptz(3)
  updated_at      DateTime              @default(now()) @updatedAt @db.Timestamptz(3)
  line_items      invoice_line_items[]
  school          schools               @relation(fields: [school_id], references: [id], onDelete: Cascade)
  subscription    school_subscriptions? @relation(fields: [subscription_id], references: [id])

  @@index([school_id])
  @@index([status])
  @@index([period_start])
  @@index([period_end])
  @@index([issue_date])
  @@index([due_date])
  @@index([paid_at])
  @@index([created_at])
  @@index([updated_at])
}

model invoice_line_items {
  id          BigInt   @id @default(autoincrement())
  invoice_id  BigInt
  description String   @db.VarChar(255)
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unit_price  Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  sort_order  Int      @default(0) @db.SmallInt
  invoice     invoices @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
}

model platform_users {
  id                               BigInt                             @id @default(autoincrement())
  uuid                             String                             @unique @db.Char(36)
  name                             String                             @db.VarChar(255)
  email                            String                             @unique @db.VarChar(255)
  password_hash                    String                             @db.VarChar(255)
  role                             PlatformUserRole                   @default(support)
  access_scope                     PlatformUserAccessScope            @default(all)
  permissions                      Json?
  status                           PlatformUserStatus                 @default(active)
  last_login_at                    DateTime?                          @db.Timestamptz(3)
  created_at                       DateTime                           @default(now()) @db.Timestamptz(3)
  updated_at                       DateTime                           @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at                       DateTime?                          @db.Timestamptz(3)
  announcements                    announcements[]
  platform_user_school_assignments platform_user_school_assignments[]
  sessions                         sessions[]
  support_tickets                  support_tickets[]

  @@index([status])
  @@index([last_login_at])
  @@index([created_at])
  @@index([updated_at])
  @@index([deleted_at])
}

model platform_user_school_assignments {
  id               BigInt         @id @default(autoincrement())
  platform_user_id BigInt
  school_id        BigInt
  created_at       DateTime       @default(now()) @db.Timestamptz(3)
  platform_user    platform_users @relation(fields: [platform_user_id], references: [id], onDelete: Cascade)
  school           schools        @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@unique([platform_user_id, school_id])
  @@index([school_id])
  @@index([created_at])
}

model announcements {
  id                 BigInt                  @id @default(autoincrement())
  title              String                  @db.VarChar(255)
  body               String
  type               AnnouncementType        @default(info)
  target_scope       AnnouncementTargetScope @default(all)
  target_values      Json?
  status             AnnouncementStatus      @default(draft)
  scheduled_at       DateTime?               @db.Timestamptz(3)
  sent_at            DateTime?               @db.Timestamptz(3)
  send_inapp         Boolean                 @default(true)
  send_email         Boolean                 @default(false)
  created_by         BigInt?
  created_at         DateTime                @default(now()) @db.Timestamptz(3)
  updated_at         DateTime                @default(now()) @updatedAt @db.Timestamptz(3)
  announcement_reads announcement_reads[]
  created_by_user    platform_users?         @relation(fields: [created_by], references: [id])

  @@index([status])
  @@index([scheduled_at])
  @@index([sent_at])
  @@index([created_at])
  @@index([updated_at])
}

model announcement_reads {
  id              BigInt        @id @default(autoincrement())
  announcement_id BigInt
  school_id       BigInt
  user_id         BigInt?
  read_at         DateTime      @default(now()) @db.Timestamptz(3)
  announcement    announcements @relation(fields: [announcement_id], references: [id], onDelete: Cascade)
  school          schools       @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@unique([announcement_id, school_id])
  @@index([school_id])
  @@index([read_at])
}

model support_tickets {
  id                     BigInt                    @id @default(autoincrement())
  ticket_number          String                    @unique @db.VarChar(20)
  school_id              BigInt
  opened_by              BigInt?
  assigned_to            BigInt?
  subject                String                    @db.VarChar(255)
  category               SupportTicketCategory     @default(technical)
  priority               SupportTicketPriority     @default(medium)
  status                 SupportTicketStatus       @default(open)
  audience               SupportTicketAudience     @default(platform_admin)
  resolved_at            DateTime?                 @db.Timestamptz(3)
  created_at             DateTime                  @default(now()) @db.Timestamptz(3)
  updated_at             DateTime                  @default(now()) @updatedAt @db.Timestamptz(3)
  messages               support_ticket_messages[]
  assigned_platform_user platform_users?           @relation(fields: [assigned_to], references: [id])
  school                 schools                   @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@index([school_id])
  @@index([status])
  @@index([resolved_at])
  @@index([created_at])
  @@index([updated_at])
}

model support_ticket_messages {
  id          BigInt                  @id @default(autoincrement())
  ticket_id   BigInt
  sender_type SupportTicketSenderType
  sender_id   BigInt
  body        String
  is_internal Boolean                 @default(false)
  created_at  DateTime                @default(now()) @db.Timestamptz(3)
  ticket      support_tickets         @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([created_at])
}

model demo_requests {
  id                 String   @id @default(uuid()) @db.Char(36)
  school_name        String   @db.VarChar(255)
  country            String   @db.VarChar(100)
  country_code       String   @db.Char(2)
  phone_country_code String   @db.VarChar(8)
  contact_name       String   @db.VarChar(255)
  job_title          String   @db.VarChar(255)
  phone              String   @db.VarChar(30)
  whatsapp           Boolean  @default(false)
  email              String   @db.VarChar(255)
  student_count      Int
  teacher_count      Int
  staff_count        Int
  has_current_system Boolean  @default(false)
  current_software   String?  @db.VarChar(255)
  modules            Json
  preferred_date     String?  @db.VarChar(20)
  preferred_time     String?  @db.VarChar(30)
  additional_details String?
  consent            Boolean  @default(false)
  status             String   @default("Pending") @db.VarChar(20)
  created_at         DateTime @default(now()) @db.Timestamptz(3)
  updated_at         DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([created_at])
  @@index([email])
}

model users {
  id                              BigInt                     @id @default(autoincrement())
  uuid                            String                     @unique @db.Char(36)
  school_id                       BigInt
  name                            String                     @db.VarChar(255)
  email                           String?                    @db.VarChar(255)
  phone                           String?                    @db.VarChar(20)
  password_hash                   String                     @db.VarChar(255)
  role                            UserRole
  status                          UserStatus                 @default(pending)
  avatar_url                      String?                    @db.VarChar(500)
  last_login_at                   DateTime?                  @db.Timestamptz(3)
  email_verified                  Boolean                    @default(false)
  created_at                      DateTime                   @default(now()) @db.Timestamptz(3)
  updated_at                      DateTime                   @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at                      DateTime?                  @db.Timestamptz(3)
  resolved_absence_alerts              absence_alerts[]
  attendance_records                   attendance_records[]
  attendance_sessions                  attendance_sessions[]
  exams                                exams[]
  published_exams                      exams[]                          @relation("exam_publisher")
  prepared_report_cards                report_cards[]                   @relation("report_card_preparer")
  approved_expenses                    expenses[]                       @relation("expense_approver")
  created_expenses                     expenses[]                       @relation("expense_creator")
  approved_payroll_runs                payroll_runs[]                   @relation("payroll_run_approver")
  fee_transactions                     fee_transactions[]
  parents_guardians                    parents_guardians[]
  class_teacher_sections               sections[]
  sessions                             sessions[]
  staff_profiles                       staff_profiles[]
  approved_student_leave_requests      student_leave_requests[]         @relation("leave_approved_by")
  created_student_leave_requests       student_leave_requests[]         @relation("leave_created_by")
  gatekeeper_leave_requests            student_leave_requests[]         @relation("leave_gate_keeper")
  students                             students[]
  teacher_section_subjects             teacher_section_subjects[]
  timetable_slots                      timetable_slots[]
  user_roles                           user_roles[]
  school                               schools                          @relation(fields: [school_id], references: [id], onDelete: Cascade)
  visitor_appointments                 visitor_appointments[]
  visitor_visits                       visitor_visits[]
  patron_dormitory_assignments         patron_dormitory_assignments[]   @relation("patron_assignments")
  patron_assignments_made              patron_dormitory_assignments[]   @relation("patron_assigned_by")
  device_assignments_made              devices[]                        @relation("device_assigned_by")
  confirmed_gate_exits                 gate_exit_records[]              @relation("exit_gate_keeper")
  boarding_att_windows_created         boarding_attendance_windows[]    @relation("att_window_created_by")
  boarding_att_records_corrected       boarding_attendance_records[]    @relation("att_corrected_by")
  dining_menus_created                 dining_menus[]                   @relation("dining_menu_creator")
  dining_schedules_created             dining_schedules[]               @relation("dining_sched_creator")
  dining_sessions_marked               dining_sessions[]                @relation("dining_session_marker")
  dining_attendance_marked             dining_attendance[]              @relation("dining_att_marker")
  dining_teacher_assignments           dining_teacher_assignments[]

  @@unique([school_id, email])
  @@index([school_id])
  @@index([role])
  @@index([status])
  @@index([last_login_at])
  @@index([created_at])
  @@index([updated_at])
  boarding_sessions_created boarding_attendance_sessions[] @relation("boarding_session_creator")
  @@index([deleted_at])
}

model roles {
  id          BigInt       @id @default(autoincrement())
  school_id   BigInt
  name        String       @db.VarChar(100)
  slug        String       @db.VarChar(100)
  permissions Json
  is_system   Boolean      @default(false)
  created_at  DateTime     @default(now()) @db.Timestamptz(3)
  updated_at  DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at  DateTime?    @db.Timestamptz(3)
  school      schools      @relation(fields: [school_id], references: [id], onDelete: Cascade)
  user_roles  user_roles[]

  @@unique([school_id, slug])
  @@index([school_id])
  @@index([created_at])
  @@index([updated_at])
  @@index([deleted_at])
}

model user_roles {
  id        BigInt  @id @default(autoincrement())
  user_id   BigInt
  role_id   BigInt
  school_id BigInt
  role      roles   @relation(fields: [role_id], references: [id], onDelete: Cascade)
  school    schools @relation(fields: [school_id], references: [id], onDelete: Cascade)
  user      users   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@index([school_id])
}

model sessions {
  id               BigInt          @id @default(autoincrement())
  user_id          BigInt?
  platform_user_id BigInt?
  school_id        BigInt?
  token_hash       String          @unique @db.VarChar(255)
  ip_address       String?         @db.VarChar(45)
  user_agent       String?         @db.VarChar(500)
  expires_at       DateTime        @db.Timestamptz(3)
  revoked_at       DateTime?       @db.Timestamptz(3)
  created_at       DateTime        @default(now()) @db.Timestamptz(3)
  platform_user    platform_users? @relation(fields: [platform_user_id], references: [id], onDelete: Cascade)
  user             users?          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([platform_user_id])
  @@index([expires_at])
  @@index([revoked_at])
  @@index([created_at])
}

model academic_years {
  id                          BigInt                        @id @default(autoincrement())
  school_id                   BigInt
  name                        String                        @db.VarChar(50)
  start_date                  DateTime                      @db.Date
  end_date                    DateTime                      @db.Date
  is_current                  Boolean                       @default(false)
  created_at                  DateTime                      @default(now()) @db.Timestamptz(3)
  deleted_at                  DateTime?                     @db.Timestamptz(3)
  school                      schools                       @relation(fields: [school_id], references: [id], onDelete: Cascade)
  fee_structures              fee_structures[]
  student_invoices            student_invoices[]
  staff_leave_balances        staff_leave_balances[]
  student_dorm_assignments    student_dorm_assignments[]
  student_section_enrollments student_section_enrollments[]
  terms                       terms[]

  @@unique([school_id, name])
  @@index([school_id])
  @@index([start_date])
  @@index([end_date])
  @@index([created_at])
  @@index([deleted_at])
}

model terms {
  id                       BigInt                     @id @default(autoincrement())
  school_id                BigInt
  academic_year_id         BigInt
  name                     String                     @db.VarChar(50)
  start_date               DateTime                   @db.Date
  end_date                 DateTime                   @db.Date
  is_current               Boolean                    @default(false)
  created_at               DateTime                   @default(now()) @db.Timestamptz(3)
  deleted_at               DateTime?                  @db.Timestamptz(3)
  fee_structures           fee_structures[]
  student_invoices         student_invoices[]
  report_cards             report_cards[]
  teacher_section_subjects teacher_section_subjects[]
  academic_year            academic_years             @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  school                   schools                    @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@index([school_id])
  @@index([start_date])
  @@index([end_date])
  @@index([created_at])
  @@index([deleted_at])
}

model classes {
  id               BigInt           @id @default(autoincrement())
  school_id        BigInt
  academic_year_id BigInt?
  name             String           @db.VarChar(20)
  level            Int              @db.SmallInt
  description      String?          @db.VarChar(255)
  created_at       DateTime         @default(now()) @db.Timestamptz(3)
  deleted_at       DateTime?        @db.Timestamptz(3)
  level_id         BigInt?
  level_label      String?          @db.VarChar(100)
  level_record     school_levels?   @relation(fields: [level_id], references: [id])
  school           schools          @relation(fields: [school_id], references: [id], onDelete: Cascade)
  dining_schedules dining_schedules[]
  dining_sessions  dining_sessions[]
  fee_structures   fee_structures[]
  sections         sections[]
  class_combinations class_combinations[]

  @@unique([school_id, name, academic_year_id])
  @@index([school_id])
  @@index([created_at])
  @@index([deleted_at])
}

model school_levels {
  id         BigInt    @id @default(autoincrement())
  school_id  BigInt
  label      String    @db.VarChar(100)
