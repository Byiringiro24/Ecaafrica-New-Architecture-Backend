model patron_dormitory_assignments {
  id           BigInt      @id @default(autoincrement())
  school_id    BigInt
  user_id      BigInt
  dormitory_id BigInt
  assigned_by  BigInt?
  assigned_at  DateTime    @default(now()) @db.Timestamptz(3)
  is_active    Boolean     @default(true)
  assignedBy   users?      @relation("patron_assigned_by", fields: [assigned_by], references: [id])
  dormitory    dormitories @relation(fields: [dormitory_id], references: [id], onDelete: Cascade)
  school       schools     @relation(fields: [school_id], references: [id], onDelete: Cascade)
  user         users       @relation("patron_assignments", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, dormitory_id])
  @@index([school_id])
  @@index([user_id])
  @@index([dormitory_id])
  @@index([is_active])
}

model gate_exit_records {
  id             BigInt                 @id @default(autoincrement())
  school_id      BigInt
  leave_id       BigInt
  student_id     BigInt
  gate_keeper_id BigInt?
  exit_at        DateTime               @default(now()) @db.Timestamptz(3)
  return_at      DateTime?              @db.Timestamptz(3)
  device_id      String?                @db.VarChar(50)
  notes          String?
  created_at     DateTime               @default(now()) @db.Timestamptz(3)
  gate_keeper    users?                 @relation("exit_gate_keeper", fields: [gate_keeper_id], references: [id])
  leave          student_leave_requests @relation(fields: [leave_id], references: [id], onDelete: Cascade)
  school         schools                @relation(fields: [school_id], references: [id], onDelete: Cascade)
  student        students               @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([school_id])
  @@index([leave_id])
  @@index([student_id])
  @@index([exit_at])
  @@index([return_at])
}

model boarding_attendance_windows {
  id               BigInt                     @id @default(autoincrement())
  school_id        BigInt
  dormitory_id     BigInt?
  name             String                     @db.VarChar(100)
  start_time       DateTime                   @db.Time
  end_time         DateTime                   @db.Time
  grace_minutes    Int                        @default(0) @db.SmallInt
  escalation_mins  Int                        @default(60) @db.SmallInt
  is_active        Boolean                    @default(true)
  applicable_days  String                     @default("mon,tue,wed,thu,fri,sat,sun") @db.VarChar(30)
  created_by       BigInt?
  created_at       DateTime                   @default(now()) @db.Timestamptz(3)
  updated_at       DateTime                   @default(now()) @updatedAt @db.Timestamptz(3)
  sessions         boarding_attendance_sessions[]
  created_by_user  users?                     @relation("att_window_created_by", fields: [created_by], references: [id])
  dormitory        dormitories?               @relation(fields: [dormitory_id], references: [id], onDelete: Cascade)
  school           schools                    @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@index([school_id])
  @@index([dormitory_id])
  @@index([is_active])
}

model boarding_attendance_sessions {
  id              BigInt                       @id @default(autoincrement())
  school_id       BigInt
  window_id       BigInt?
  dormitory_id    BigInt?
  session_name    String?                      @db.VarChar(150)
  location_type   String                       @default("dormitory") @db.VarChar(50)
  created_by      BigInt?
  session_date    DateTime                     @db.Date
  window_start    DateTime?                    @db.Timestamptz(3)
  window_end      DateTime?                    @db.Timestamptz(3)
  reconciled_at   DateTime?                    @db.Timestamptz(3)
  total_expected  Int                          @default(0)
  total_present   Int                          @default(0)
  total_late      Int                          @default(0)
  total_on_leave  Int                          @default(0)
  total_missing   Int                          @default(0)
  notes           String?
  created_at      DateTime                     @default(now()) @db.Timestamptz(3)
  records         boarding_attendance_records[]
  dormitory       dormitories?                 @relation(fields: [dormitory_id], references: [id], onDelete: Cascade)
  school          schools                      @relation(fields: [school_id], references: [id], onDelete: Cascade)
  window          boarding_attendance_windows? @relation(fields: [window_id], references: [id], onDelete: SetNull)
  creator         users?                       @relation("boarding_session_creator", fields: [created_by], references: [id], onDelete: SetNull)
  @@index([school_id])
  @@index([dormitory_id])
  @@index([session_date])
  @@index([reconciled_at])
  @@index([location_type])
  @@index([created_by])
}

model boarding_attendance_records {
  id                  BigInt                    @id @default(autoincrement())
  school_id           BigInt
  session_id          BigInt
  student_id          BigInt
  dormitory_id        BigInt?
  status              BoardingAttendanceStatus  @default(missing_attendance)
  scan_time           DateTime?                 @db.Timestamptz(3)
  biometric_log_id    BigInt?
  is_manual           Boolean                   @default(false)
  manual_reason       String?
  corrected_by        BigInt?
  corrected_at        DateTime?                 @db.Timestamptz(3)
  original_status     BoardingAttendanceStatus?
  parent_notified_at  DateTime?                 @db.Timestamptz(3)
  escalated_at        DateTime?                 @db.Timestamptz(3)
  notes               String?
  created_at          DateTime                  @default(now()) @db.Timestamptz(3)
  updated_at          DateTime                  @default(now()) @updatedAt @db.Timestamptz(3)
  corrected_by_user   users?                    @relation("att_corrected_by", fields: [corrected_by], references: [id])
  dormitory           dormitories?              @relation(fields: [dormitory_id], references: [id])
  school              schools                   @relation(fields: [school_id], references: [id], onDelete: Cascade)
  session             boarding_attendance_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)
  student             students                  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([session_id, student_id])
  @@index([school_id])
  @@index([session_id])
  @@index([student_id])
  @@index([dormitory_id])
  @@index([status])
  @@index([scan_time])
  @@index([escalated_at])
}

model boarding_configurations {
  id                          BigInt   @id @default(autoincrement())
  school_id                   BigInt   @unique
  require_student_photo       Boolean  @default(true)
  require_biometric_return    Boolean  @default(true)
  require_gate_exit_confirm   Boolean  @default(true)
  parent_escalation_mins      Int      @default(60) @db.SmallInt
  late_return_threshold_mins  Int      @default(15) @db.SmallInt
  max_short_leave_hours       Int      @default(8) @db.SmallInt
  max_long_leave_days         Int      @default(14) @db.SmallInt
  sms_on_leave_approval       Boolean  @default(true)
  sms_on_long_leave           Boolean  @default(true)
  sms_on_medical_leave        Boolean  @default(true)
  sms_on_missing_attendance   Boolean  @default(true)
  sms_on_late_return          Boolean  @default(true)
  created_at                  DateTime @default(now()) @db.Timestamptz(3)
  updated_at                  DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  school                      schools  @relation(fields: [school_id], references: [id], onDelete: Cascade)
}

model dining_menus {
  id         BigInt             @id @default(autoincrement())
  school_id  BigInt
  name       String             @db.VarChar(100)
  menu_type  String             @default("weekly") @db.VarChar(20)
  start_date DateTime?          @db.Date
  end_date   DateTime?          @db.Date
  is_active  Boolean            @default(true)
  created_by BigInt?
  created_at DateTime           @default(now()) @db.Timestamptz(3)
  updated_at DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  items      dining_menu_items[]
  creator    users?             @relation("dining_menu_creator", fields: [created_by], references: [id])
  school     schools            @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@index([school_id])
  @@index([is_active])
  @@index([start_date])
}

model dining_menu_items {
  id          BigInt         @id @default(autoincrement())
  menu_id     BigInt
  school_id   BigInt
  day_of_week Int            @db.SmallInt
  meal_type   DiningMealType
  items       String
  notes       String?
  created_at  DateTime       @default(now()) @db.Timestamptz(3)
  menu        dining_menus   @relation(fields: [menu_id], references: [id], onDelete: Cascade)
  school      schools        @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@index([menu_id])
  @@index([school_id])
  @@index([day_of_week])
}

model dining_schedules {
  id               BigInt              @id @default(autoincrement())
  school_id        BigInt
  scope            DiningScheduleScope @default(dormitory)
  dormitory_id     BigInt?
  room_id          BigInt?
  class_id         BigInt?
  meal_type        DiningMealType
  start_time       DateTime            @db.Time
  end_time         DateTime            @db.Time
  applicable_days  String              @default("mon,tue,wed,thu,fri,sat,sun") @db.VarChar(30)
  is_active        Boolean             @default(true)
  created_by       BigInt?
  created_at       DateTime            @default(now()) @db.Timestamptz(3)
  updated_at       DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  sessions         dining_sessions[]
  class            classes?            @relation(fields: [class_id], references: [id])
  created_by_user  users?              @relation("dining_sched_creator", fields: [created_by], references: [id])
  dormitory        dormitories?        @relation(fields: [dormitory_id], references: [id], onDelete: Cascade)
  room             dorm_rooms?         @relation(fields: [room_id], references: [id], onDelete: Cascade)
  school           schools             @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@index([school_id])
  @@index([dormitory_id])
  @@index([meal_type])
  @@index([is_active])
}

model dining_sessions {
  id           BigInt             @id @default(autoincrement())
  school_id    BigInt
  schedule_id  BigInt?
  dormitory_id BigInt?
  class_id     BigInt?
  gender_group String?             @db.VarChar(20)
  meal_type    DiningMealType
  session_date DateTime           @db.Date
  opened_at    DateTime?          @db.Timestamptz(3)
  closed_at    DateTime?          @db.Timestamptz(3)
  marked_by    BigInt?
  notes        String?
  created_at   DateTime           @default(now()) @db.Timestamptz(3)
  attendance   dining_attendance[]
  dormitory    dormitories?       @relation(fields: [dormitory_id], references: [id], onDelete: Cascade)
  class        classes?           @relation(fields: [class_id], references: [id])
  marker       users?             @relation("dining_session_marker", fields: [marked_by], references: [id])
  schedule     dining_schedules?  @relation(fields: [schedule_id], references: [id], onDelete: SetNull)
  school       schools            @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@index([school_id])
  @@index([dormitory_id])
  @@index([class_id])
  @@index([session_date])
  @@index([meal_type])
}

model dining_teacher_assignments {
  id           BigInt   @id @default(autoincrement())
  school_id    BigInt
  teacher_id   BigInt
  gender_group String   @db.VarChar(20)
  start_date   DateTime @db.Date
  end_date     DateTime @db.Date
  assigned_by  BigInt?
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  updated_at   DateTime @updatedAt @db.Timestamptz(3)
  school       schools  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  teacher      users    @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@index([school_id, start_date, end_date])
  @@index([teacher_id, start_date, end_date])
  @@unique([school_id, teacher_id, gender_group, start_date, end_date])
}

model dining_attendance {
  id           BigInt                 @id @default(autoincrement())
  school_id    BigInt
  session_id   BigInt
  student_id   BigInt
  status       DiningAttendanceStatus @default(absent)
  marked_by    BigInt?
  marked_at    DateTime?              @db.Timestamptz(3)
  leave_status String?                @db.VarChar(50)
  notes        String?                @db.VarChar(255)
  created_at   DateTime               @default(now()) @db.Timestamptz(3)
  marker       users?                 @relation("dining_att_marker", fields: [marked_by], references: [id])
  school       schools                @relation(fields: [school_id], references: [id], onDelete: Cascade)
  session      dining_sessions        @relation(fields: [session_id], references: [id], onDelete: Cascade)
  student      students               @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([session_id, student_id])
  @@index([school_id])
  @@index([session_id])
  @@index([student_id])
  @@index([status])
}

/// DOS-owned academic workflow records. `payload` stores the type-specific
/// fields so new DOS workflows do not alter School Admin domain tables.
model dos_work_items {
  id          BigInt   @id @default(autoincrement())
  school_id   BigInt
  type        String   @db.VarChar(50)
  title       String   @db.VarChar(255)
  status      String   @default("open") @db.VarChar(30)
  priority    String   @default("normal") @db.VarChar(20)
  student_id  BigInt?
  payload     Json
  created_by  BigInt?
  updated_by  BigInt?
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  school      schools  @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@index([school_id, type])
  @@index([school_id, status])
  @@index([school_id, student_id])
  @@index([created_at])
}
