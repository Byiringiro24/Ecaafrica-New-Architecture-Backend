# Example environment variables for local development
# Copy this file to .env and replace the placeholder values with your real local secrets.

DATABASE_URL="postgresql://username:password@localhost:5432/ECAREAFRICA?schema=public&sslmode=disable"
JWT_SECRET=replace_with_a_secure_random_secret
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret
PLATFORM_JWT_SECRET=replace_with_a_secure_random_platform_secret
PLATFORM_JWT_REFRESH_SECRET=replace_with_a_secure_random_platform_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=5501
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5500,http://192.168.1.75:5173
RATE_LIMIT_ENABLED=false

S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=replace_with_s3_access_key
S3_SECRET_ACCESS_KEY=replace_with_s3_secret
S3_PUBLIC_URL=https://pub.example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@example.com

REDIS_URL=redis://localhost:6379

SMS_UGANDA_API_URL=http://text.emediauganda.com/api.php
SMS_UGANDA_USER=your_username
SMS_UGANDA_PASSWORD=your_password
SMS_UGANDA_SENDER=EducationCare

APP_BASE_URL=http://localhost:5000
