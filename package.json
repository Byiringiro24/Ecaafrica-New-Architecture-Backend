{
  "name": "ecareafrica-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node api.js && nodemon --watch src --ext ts --exec \"node --max-old-space-size=2048 -r ts-node/register/transpile-only src/server.ts\"",
    "build": "node api.js && tsc -p tsconfig.json",
    "start": "node api.js && node dist/server.js",
    "prisma:generate": "prisma generate --schema src/models/schema.prisma",
    "prisma:format": "prisma format --schema src/models/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/models/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema src/models/schema.prisma",
    "prisma:deploy": "npm run prisma:generate && npm run prisma:migrate:deploy && npm run build",
    "migrate:seed": "npm run prisma:migrate:deploy && npm run seed",
    "seed": "ts-node src/seeders/index.ts",
    "seed:plans": "ts-node src/seeders/plans.seeder.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:db:up": "docker-compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker-compose -f docker-compose.test.yml down -v",
    "test:ci": "npm run test:db:up && jest --runInBand && npm run test:db:down"
  },
  "prisma": {
    "schema": "src/models/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "axios": "^1.18.1",
    "bullmq": "^5.77.2",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dayjs": "^1.11.20",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.21.0",
    "pino": "^8.17.1",
    "pino-http": "^9.0.0",
    "redis": "^6.3.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.0",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.12",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^2.0.16",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prisma": "^5.22.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
