# ── WireGuard VPN (server-side management) ───────────────────────────────────
# These are read by wireguard.service.ts on the Linux server.
# The defaults match the standard setup from wireguard-full-setup-guide.md.

# Path to wg0.conf (default: /etc/wireguard/wg0.conf)
WG_CONF_PATH=/etc/wireguard/wg0.conf

# Path to the server's public key file (generated during server setup)
WG_PUBKEY_PATH=/etc/wireguard/server_public.key

# WireGuard interface name (default: wg0)
WG_INTERFACE=wg0

# VPN subnet prefix — /16 supports 65534 tablet peers (10.0.x.x)
# Default: "10.0" → IPs 10.0.0.2, 10.0.0.3 … 10.0.255.254
VPN_SUBNET=10.0

# VPN CIDR — /16 for 65534 hosts (100+ tablets), /24 for 253 (small deployments)
VPN_CIDR=16

# Server's own VPN IP (always first host in subnet)
SERVER_VPN_IP=10.0.0.1

# Server public IP (shown in tablet wizard as the endpoint to connect to)
SERVER_PUBLIC_IP=169.58.124.150

# WireGuard listen port (must match ufw allow rule and tablet wizard)
WG_PORT=51820

# ── Pull-logs job tuning (for 100+ tablets) ──────────────────────────────────
# Max tablets to pull from simultaneously (default: 10)
# Lower = less server load. Higher = faster sweeps.
PULL_CONCURRENCY=10

# Pull interval in ms (default: 5000 = 5 seconds)
PULL_LOGS_INTERVAL_MS=5000

# Per-tablet pull timeout in ms (default: 20000 = 20 seconds)
PULL_TIMEOUT_MS=20000

# ── SSE connection tuning (for 100+ tablets) ─────────────────────────────────
# Max SSE connections to open per refresh cycle (default: 10)
SSE_CONNECT_CONCURRENCY=10

# Stagger delay between SSE connections in ms (default: 200)
# Prevents 100 tablets from all connecting at startup in the same millisecond
SSE_CONNECT_STAGGER_MS=200

# Dedup cache size for SSE + pull-log overlap prevention (default: 10000)
# With 100 tablets × ~50 events = 5000 entries. 10000 gives 2x headroom.
SSE_DEDUP_CACHE_SIZE=10000

# WireGuard VPN — Server-side configuration
# These must match the actual WireGuard setup on the Linux server
WG_CONF_PATH=/etc/wireguard/wg0.conf
WG_PUBKEY_PATH=/etc/wireguard/server_public.key
WG_PRIVKEY_PATH=/etc/wireguard/server_private.key
WG_INTERFACE=wg0
SERVER_PUBLIC_IP=169.58.124.150
WG_PORT=51820
VPN_SUBNET=10.0
VPN_CIDR=16
SERVER_VPN_IP=10.0.0.1
